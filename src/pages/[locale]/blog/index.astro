---
import Base from "../../../layouts/Base.astro";
import BlogFilter from "../../../components/BlogFilter.vue";
import { getCollection } from "astro:content";
import { locales, type Locale } from "../../../consts";
import { useTranslations, getLocalePath, groupPostsByTranslation } from "../../../i18n/utils";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);

const allPosts = await getCollection("blog");
const groups = groupPostsByTranslation(allPosts, locale)
  .sort((a, b) => b.canonical.data.date.getTime() - a.canonical.data.date.getTime());

const postsForFilter = groups.map(({ canonical, availableLocales }) => ({
  slug: canonical.id,
  title: canonical.data.title,
  date: canonical.data.date.toISOString(),
  locale: canonical.data.locale,
  availableLocales,
  tags: canonical.data.tags,
  description: canonical.data.description,
  readingTime: canonical.data.readingTime as number,
  habr: canonical.data.habr,
  video: canonical.data.video,
  href: getLocalePath(locale, `blog/${canonical.id}`),
}));

const languages = locales.filter((l) =>
  groups.some(({ availableLocales }) => availableLocales.includes(l)),
);
---

<Base title={t("blog.title")} locale={locale}>
  <div class="blog-page">
    <h1 class="blog-heading">{t("blog.title")}</h1>

    <BlogFilter
      client:load
      posts={postsForFilter}
      languages={languages}
      allLanguagesLabel={t("blog.allLanguages")}
      allTagsLabel={t("blog.allTags")}
      noResultsLabel={t("blog.noResults")}
      readingTimeLabel={t("blog.readingTime")}
      pageLocale={locale}
    />
  </div>
</Base>

<style>
  .blog-page {
    max-width: 680px;
    margin: 0 auto;
  }

  .blog-heading {
    font-family: var(--font-serif);
    font-size: 2.5586rem;
    font-weight: bold;
    line-height: 1;
    margin: 1rem 0 1.5rem;
    color: var(--color-text);
  }
</style>
